FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /auth-setup ./auth-service/cmd/setup

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /auth-setup /auth-setup
ENTRYPOINT ["/auth-setup"]
