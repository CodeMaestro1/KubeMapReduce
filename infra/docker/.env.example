# Keycloak
KC_DB=dev-file
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mapreduce/protocol/openid-connect/certs

# Manager / API
MANAGER_INTERNAL_API_KEY=local-dev-key
MANAGER_WORKER_RPC_TOKEN=local-dev-token
ALLOW_INSECURE_WORKER_RPC=true

# PostgreSQL
POSTGRES_USER=mapreduce
POSTGRES_PASSWORD=mapreduce
POSTGRES_DB=mapreduce
DATABASE_DSN=postgres://mapreduce:mapreduce@postgres:5432/mapreduce?sslmode=disable

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
